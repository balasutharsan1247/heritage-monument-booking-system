# Deployed API URL (backend root + /api)
# Example for Render: https://your-backend.onrender.com/api
# If left empty, defaults to window.location.origin/api in production or http://localhost:5000/api in development
VITE_API_URL=https://your-backend.onrender.com/api

# Deployed Socket URL (backend root without /api)
# Example for Render: https://your-backend.onrender.com
# If left empty, automatically derived from VITE_API_URL
VITE_SOCKET_URL=https://your-backend.onrender.com

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Test Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
